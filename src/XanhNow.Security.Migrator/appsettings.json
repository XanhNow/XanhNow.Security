{
  "Vault": {
    "Address": "https://192.168.2.81:8200",
    "AuthMount": "approle",
    "RoleIdFile": "/etc/xanhnow/security/vault/role_id",
    "SecretIdFile": "/etc/xanhnow/security/vault/secret_id",
    "CaCertFile": "/etc/xanhnow/security/trust/vault-ca.crt"
  },
  "SecurityMigrator": {
    "EnvironmentName": "Production",
    "ExpectedSchema": "security",
    "ExpectedDatabase": "authtest",
    "ExpectedRole": "xanhnow_security_migrator",
    "LockKey": "xanhnow.security.migrator",
    "AllowApply": false,
    "Credential": {
      "Provider": "Vault",
      "VaultSecretPath": "kv/xanhnow/security/postgres/migration",
      "VaultField": "SecurityMigratorDb"
    }
  }
}
