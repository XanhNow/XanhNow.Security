{
  "Vault": {
    "Address": "https://192.168.2.81:8200",
    "AuthMount": "approle",
    "RoleIdFile": "/etc/xanhnow/s101/security/vault/migrator-role_id",
    "SecretIdFile": "/etc/xanhnow/s101/security/vault/migrator-secret_id",
    "CaCertFile": "/etc/xanhnow/s101/security/trust/vault-ca.crt"
  },
  "SecurityMigrator": {
    "EnvironmentName": "Production",
    "ExpectedSchema": "security",
    "ExpectedDatabase": "authtest",
    "ExpectedRole": "s101_xanhnow_auth_security_migrator",
    "LockKey": "s101.xanhnow.auth.security.migrator",
    "AllowApply": false,
    "Credential": {
      "Provider": "Vault",
      "VaultSecretPath": "kv/xanhnow/s101/security/postgres/migration",
      "VaultField": "connection_string"
    }
  }
}
