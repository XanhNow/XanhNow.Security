CREATE ROLE s101_xanhnow_auth_security_runtime NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
CREATE ROLE s101_xanhnow_auth_security_migrator NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;

GRANT CONNECT ON DATABASE REPLACE_DATABASE TO s101_xanhnow_auth_security_runtime;
GRANT CONNECT ON DATABASE REPLACE_DATABASE TO s101_xanhnow_auth_security_migrator;

CREATE SCHEMA IF NOT EXISTS security AUTHORIZATION s101_xanhnow_auth_security_migrator;

GRANT USAGE ON SCHEMA security TO s101_xanhnow_auth_security_runtime;
GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA security TO s101_xanhnow_auth_security_runtime;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA security TO s101_xanhnow_auth_security_runtime;
GRANT USAGE, CREATE ON SCHEMA security TO s101_xanhnow_auth_security_migrator;

REVOKE ALL ON SCHEMA auth, token, passkey, auth_smart_otp
  FROM s101_xanhnow_auth_security_runtime, s101_xanhnow_auth_security_migrator;

ALTER DEFAULT PRIVILEGES FOR ROLE s101_xanhnow_auth_security_migrator
  IN SCHEMA security
  GRANT SELECT, INSERT, UPDATE ON TABLES TO s101_xanhnow_auth_security_runtime;

ALTER DEFAULT PRIVILEGES FOR ROLE s101_xanhnow_auth_security_migrator
  IN SCHEMA security
  GRANT USAGE, SELECT ON SEQUENCES TO s101_xanhnow_auth_security_runtime;
