{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SecurityWorker": {
    "ServiceIdentity": "xanhnow-security-worker",
    "ShutdownTimeout": "00:00:30",
    "OutboxDispatcher": {
      "Name": "outbox-dispatcher",
      "Enabled": true,
      "Interval": "00:00:30",
      "BatchSize": 25,
      "MaxConcurrency": 1,
      "Lease": "00:02:00",
      "MaxAttempts": 5,
      "BaseDelay": "00:00:05",
      "MaxDelay": "00:05:00",
      "JitterPercent": 20
    },
    "OutboxRetry": { "Name": "outbox-retry", "Enabled": false },
    "DeadLetterMonitor": { "Name": "dead-letter-monitor", "Enabled": false },
    "OutboxCleanup": { "Name": "outbox-cleanup", "Enabled": false },
    "OperationRetry": { "Name": "operation-retry", "Enabled": false },
    "RecoveryResume": { "Name": "recovery-resume", "Enabled": false },
    "GrantExpiry": { "Name": "grant-expiry", "Enabled": false },
    "ExpiredOperation": { "Name": "expired-operation", "Enabled": false },
    "RetentionCleanup": { "Name": "retention-cleanup", "Enabled": false },
    "PolicyCacheRefresh": { "Name": "policy-cache-refresh", "Enabled": false },
    "ProjectionRefresh": { "Name": "projection-refresh", "Enabled": false }
  }
}
