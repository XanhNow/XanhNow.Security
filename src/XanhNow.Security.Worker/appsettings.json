{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SecurityWorker": {
    "ServiceIdentity": "xanhnow-security-worker",
    "ShutdownTimeout": "00:00:30",
    "OutboxDispatcher": {
      "Name": "outbox-dispatcher",
      "Enabled": true,
      "Interval": "00:00:30",
      "BatchSize": 25,
      "MaxConcurrency": 1,
      "Lease": "00:02:00",
      "MaxAttempts": 5,
      "BaseDelay": "00:00:05",
      "MaxDelay": "00:05:00",
      "JitterPercent": 20
    },
    "OutboxRetry": { "Name": "outbox-retry", "Enabled": false },
    "DeadLetterMonitor": { "Name": "dead-letter-monitor", "Enabled": false },
    "OutboxCleanup": { "Name": "outbox-cleanup", "Enabled": false },
    "OperationRetry": { "Name": "operation-retry", "Enabled": false },
    "RecoveryResume": { "Name": "recovery-resume", "Enabled": false },
    "GrantExpiry": { "Name": "grant-expiry", "Enabled": false },
    "ExpiredOperation": { "Name": "expired-operation", "Enabled": false },
    "RetentionCleanup": { "Name": "retention-cleanup", "Enabled": false },
    "PolicyCacheRefresh": { "Name": "policy-cache-refresh", "Enabled": false },
    "ProjectionRefresh": { "Name": "projection-refresh", "Enabled": false }
  },
  "SecurityIntegration": {
    "AuthLogin": { "Name": "Auth_Login_App", "BaseAddress": "http://192.168.2.25:8080" },
    "Jwt": { "Name": "JWT_Refresh_Token_App", "BaseAddress": "http://192.168.2.25:5102" },
    "Passkey": { "Name": "Passkey_Provider_App", "BaseAddress": "http://192.168.2.25:5101" },
    "SmartOtp": { "Name": "SmartOtp_App", "BaseAddress": "https://192.168.2.25:5104", "RequiresMtls": true, "TrustedCaPath": "/etc/xanhnow/auth-smart-otp/mtls/ca/smart-otp-grpc-client-ca.crt", "ClientCertificatePath": "/etc/xanhnow/security/mtls/smart-otp/auth-gateway-client.crt", "ClientCertificateKeyPath": "/etc/xanhnow/security/mtls/smart-otp/auth-gateway-client.key" },
    "Vault": { "Address": "https://192.168.2.81:8200", "RoleIdFile": "/etc/xanhnow/security/vault/role_id", "SecretIdFile": "/etc/xanhnow/security/vault/secret_id", "CaCertFile": "/etc/xanhnow/security/trust/vault-ca.crt", "GrantSigningKeyPath": "kv/xanhnow/security/grants/signing", "GrantSigningKeyField": "signing_key" },
    "Redis": { "Mode": "Redis", "BootstrapEndpoints": "192.168.2.16:6379,192.168.2.33:6379,192.168.2.53:6379", "SecretPath": "kv/xanhnow/security/redis", "PasswordField": "password", "KeyPrefix": "xanhnow:security", "AbortOnConnectFail": false },
    "Kafka": { "Mode": "Kafka", "BootstrapServers": "192.168.2.14:9092,192.168.2.31:9092,192.168.2.51:9092", "SecurityEventsTopic": "xanhnow.security.events", "SecurityAuditTopic": "xanhnow.security.audit", "ClientId": "xanhnow-security-producer", "Acks": "all", "EnableIdempotentProducer": true }
  }
}