{
  "SecurityApi": {
    "RequireHttps": false,
    "EnableStrictTransportSecurity": false
  },
  "SecurityIntegration": {
    "Vault": {
      "Address": "https://192.168.2.81:8200",
      "AuthMount": "approle",
      "RoleIdEnvironmentVariable": "XANHNOW_SECURITY_VAULT_ROLE_ID",
      "SecretIdEnvironmentVariable": "XANHNOW_SECURITY_VAULT_SECRET_ID",
      "RoleIdFile": "/etc/xanhnow/s101/security/vault/role_id",
      "SecretIdFile": "/etc/xanhnow/s101/security/vault/secret_id",
      "CaCertFile": "/etc/xanhnow/s101/security/trust/vault-ca.crt",
      "GrantSigningKeyPath": "kv/xanhnow/s101/security/grants/signing",
      "GrantSigningKeyField": "signing_key",
      "GrantSigningKeyFile": "/srv/xanhnow/s101/secrets/security/grant-signing-key",
      "PostgresApiSecretPath": "kv/xanhnow/s101/security/postgres/runtime",
      "PostgresConnectionStringField": "connection_string",
      "PostgresConnectionStringFile": "/srv/xanhnow/s101/secrets/security/postgres-connection-string"
    },
    "AuthLogin": {
      "Name": "Auth_Login_App",
      "BaseAddress": "http://127.0.0.1:8080"
    },
    "Jwt": {
      "Name": "JWT_Refresh_Token_App",
      "BaseAddress": "http://127.0.0.1:5102"
    },
    "Passkey": {
      "Name": "Passkey_Provider_App",
      "BaseAddress": "http://127.0.0.1:5101"
    },
    "SmartOtp": {
      "Name": "SmartOtp_App",
      "BaseAddress": "http://127.0.0.1:5104",
      "RequiresMtls": false
    }
  }
}
