{
  "ConnectionStrings": {
    "SecurityDb": ""
  },
  "SecurityApi": {
    "ServiceName": "XanhNow.Security",
    "ContractVersion": "v1",
    "RequireHttps": false,
    "AllowedOrigins": [],
    "KnownProxies": [],
    "MaxRequestBodyBytes": 1048576,
    "MaxRequestHeadersTotalSizeBytes": 32768,
    "RequestHeadersTimeoutSeconds": 10,
    "RequestTimeoutSeconds": 15,
    "MaxCorrelationIdLength": 128,
    "EnableSecurityHeaders": true,
    "EnableStrictTransportSecurity": false,
    "AnonymousRequestsPerMinute": 60,
    "UserRequestsPerMinute": 120,
    "ServiceRequestsPerMinute": 300
  },
  "SecurityIntegration": {
    "AuthLogin": { "Name": "Auth_Login_App", "BaseAddress": "http://127.0.0.1:8080" },
    "Jwt": { "Name": "JWT_Refresh_Token_App", "BaseAddress": "http://127.0.0.1:5102" },
    "Passkey": { "Name": "Passkey_Provider_App", "BaseAddress": "http://127.0.0.1:5101" },
    "SmartOtp": { "Name": "SmartOtp_App", "BaseAddress": "https://127.0.0.1:5104", "RequiresMtls": true, "TrustedCaPath": "/etc/xanhnow/auth-smart-otp/mtls/ca/smart-otp-grpc-client-ca.crt", "ClientCertificatePath": "/etc/xanhnow/security/mtls/smart-otp/auth-gateway-client.crt", "ClientCertificateKeyPath": "/etc/xanhnow/security/mtls/smart-otp/auth-gateway-client.key" },
    "Vault": { "Address": "https://192.168.2.81:8200", "AuthMount": "approle", "RoleIdFile": "/etc/xanhnow/security/vault/role_id", "SecretIdFile": "/etc/xanhnow/security/vault/secret_id", "CaCertFile": "/etc/xanhnow/security/trust/vault-ca.crt", "GrantSigningKeyPath": "kv/xanhnow/security/grants/signing", "GrantSigningKeyField": "signing_key" },
    "Redis": { "Mode": "Redis", "BootstrapEndpoints": "192.168.2.16:6379,192.168.2.33:6379,192.168.2.53:6379", "SecretPath": "kv/xanhnow/security/redis", "PasswordField": "password", "KeyPrefix": "xanhnow:security", "ConnectTimeoutMs": 5000, "OperationTimeoutMs": 3000, "AbortOnConnectFail": false },
    "Kafka": { "BootstrapServers": "127.0.0.1:9092", "SecurityEventsTopic": "xanhnow.security.events", "SecurityAuditTopic": "xanhnow.security.audit" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
