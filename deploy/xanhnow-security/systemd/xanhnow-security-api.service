[Unit]
Description=XanhNow Security API
After=network-online.target xanhnow-security-vault-agent.service
Wants=network-online.target xanhnow-security-vault-agent.service

[Service]
Type=simple
User=xanhnow
Group=xanhnow
WorkingDirectory=/srv/xanhnow/apps/xanhnow-security-api/current
ExecStart=/usr/bin/dotnet /srv/xanhnow/apps/xanhnow-security-api/current/XanhNow.Security.Api.dll
Restart=always
RestartSec=5
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:5200

[Install]
WantedBy=multi-user.target
