[Unit]
Description=XanhNow Security Worker
After=network-online.target xanhnow-security-vault-agent.service
Wants=network-online.target xanhnow-security-vault-agent.service

[Service]
Type=simple
User=xanhnow
Group=xanhnow
WorkingDirectory=/srv/xanhnow/apps/xanhnow-security-worker/current
ExecStart=/usr/bin/dotnet /srv/xanhnow/apps/xanhnow-security-worker/current/XanhNow.Security.Worker.dll
Restart=always
RestartSec=5
Environment=DOTNET_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target
