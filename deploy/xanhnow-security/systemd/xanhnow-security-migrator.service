[Unit]
Description=XanhNow Security Migrator
After=network-online.target xanhnow-security-vault-agent.service
Wants=network-online.target xanhnow-security-vault-agent.service

[Service]
Type=oneshot
User=xanhnow
Group=xanhnow
WorkingDirectory=/srv/xanhnow/apps/xanhnow-security-migrator/current
ExecStart=/usr/bin/dotnet /srv/xanhnow/apps/xanhnow-security-migrator/current/XanhNow.Security.Migrator.dll apply
Environment=DOTNET_ENVIRONMENT=Production
Environment=SecurityMigrator__AllowApply=true

[Install]
WantedBy=multi-user.target
